APP_NAME="Jono Advertising"

# In production: APP_ENV=production and APP_DEBUG=false.
# APP_DEBUG=true on a live site leaks stack traces and config values.
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# Absolute URLs in the sitemap, emails and signed unsubscribe links come from
# this, so it must match the real domain in production.
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# SQLite locally; switch to mysql in production.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=jonoads
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Mail: 'log' writes to storage/logs instead of sending. Swap to smtp for real delivery.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="hello@jonoads.com"
MAIL_FROM_NAME="${APP_NAME}"

# Address shown in the footer and used for enquiry notifications.
MAIL_CONTACT_ADDRESS=info@jonoadvertising.com

# Footer community link.
SKOOL_URL=https://www.skool.com

# First admin account, created by AdminUserSeeder. Set these before seeding
# anywhere that is not a local machine. Leave ADMIN_PASSWORD unset (not set
# to an empty string) to get the local-only fallback of "password" — an
# empty value here is still a value, so it would seed an empty password.
ADMIN_NAME="Jono Admin"
ADMIN_EMAIL=admin@jonoads.com
#ADMIN_PASSWORD=
